{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "description": "One row per managed project, taken from the last run of `my_warp.sh --lib github commit_status` that falls inside the dashboard time range. Run the script when the table is empty, or when `Last run` is older than you expect.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true,
            "inspect": false
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "notification.title"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "auto"
                }
              },
              {
                "id": "custom.width",
                "value": 160
              },
              {
                "id": "displayName",
                "value": "Project"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "commit (first)"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "options": {
                      "pattern": "^clean$",
                      "result": {
                        "color": "green",
                        "index": 0,
                        "text": "clean"
                      }
                    },
                    "type": "regex"
                  },
                  {
                    "options": {
                      "pattern": "changed path",
                      "result": {
                        "color": "orange",
                        "index": 1
                      }
                    },
                    "type": "regex"
                  },
                  {
                    "options": {
                      "pattern": "^SKIP",
                      "result": {
                        "color": "red",
                        "index": 2
                      }
                    },
                    "type": "regex"
                  }
                ]
              },
              {
                "id": "displayName",
                "value": "Commit"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "push (first)"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "options": {
                      "pattern": "^up to date$",
                      "result": {
                        "color": "green",
                        "index": 0
                      }
                    },
                    "type": "regex"
                  },
                  {
                    "options": {
                      "pattern": "to push",
                      "result": {
                        "color": "orange",
                        "index": 1
                      }
                    },
                    "type": "regex"
                  },
                  {
                    "options": {
                      "pattern": "no upstream",
                      "result": {
                        "color": "text",
                        "index": 2
                      }
                    },
                    "type": "regex"
                  }
                ]
              },
              {
                "id": "displayName",
                "value": "Push"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "behind (first)"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "options": {
                      "pattern": "^up to date$",
                      "result": {
                        "color": "green",
                        "index": 0
                      }
                    },
                    "type": "regex"
                  },
                  {
                    "options": {
                      "pattern": "commit",
                      "result": {
                        "color": "orange",
                        "index": 1
                      }
                    },
                    "type": "regex"
                  },
                  {
                    "options": {
                      "pattern": "^fetch failed",
                      "result": {
                        "color": "red",
                        "index": 2
                      }
                    },
                    "type": "regex"
                  }
                ]
              },
              {
                "id": "displayName",
                "value": "Behind"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "issues (first)"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "options": {
                      "pattern": "^0$",
                      "result": {
                        "color": "green",
                        "index": 0
                      }
                    },
                    "type": "regex"
                  },
                  {
                    "options": {
                      "pattern": "^[1-9][0-9]*\\+?$",
                      "result": {
                        "color": "orange",
                        "index": 1
                      }
                    },
                    "type": "regex"
                  },
                  {
                    "options": {
                      "pattern": "failed",
                      "result": {
                        "color": "red",
                        "index": 2
                      }
                    },
                    "type": "regex"
                  }
                ]
              },
              {
                "id": "custom.width",
                "value": 130
              },
              {
                "id": "displayName",
                "value": "Open issues"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "last_run (first)"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 200
              },
              {
                "id": "displayName",
                "value": "Last run"
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 16,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "cellHeight": "sm",
        "footer": {
          "countRows": false,
          "enablePagination": false,
          "fields": "",
          "reducer": [
            "sum"
          ],
          "show": false
        },
        "showHeader": true,
        "sortBy": [
          {
            "desc": false,
            "displayName": "Project"
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "editorMode": "code",
          "expr": "service.name:\"commit-status\" | extract \"<commit> | <push> | <behind> | <issues>\" from _msg | stats by (\"notification.title\", commit, push, behind, issues) max(_time) as last_run",
          "queryType": "log",
          "refId": "A"
        }
      ],
      "title": "Per-project status",
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "source": "labels",
            "format": "json",
            "replace": true,
            "keepTime": false
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "last_run",
                "desc": true
              }
            ]
          }
        },
        {
          "id": "groupBy",
          "options": {
            "fields": {
              "notification.title": {
                "aggregations": [],
                "operation": "groupby"
              },
              "commit": {
                "aggregations": [
                  "first"
                ],
                "operation": "aggregate"
              },
              "push": {
                "aggregations": [
                  "first"
                ],
                "operation": "aggregate"
              },
              "behind": {
                "aggregations": [
                  "first"
                ],
                "operation": "aggregate"
              },
              "issues": {
                "aggregations": [
                  "first"
                ],
                "operation": "aggregate"
              },
              "last_run": {
                "aggregations": [
                  "first"
                ],
                "operation": "aggregate"
              }
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "notification.title": "Project",
              "commit (first)": "Commit",
              "push (first)": "Push",
              "behind (first)": "Behind",
              "issues (first)": "Open issues",
              "last_run (first)": "Last run"
            }
          }
        }
      ],
      "type": "table"
    }
  ],
  "preload": false,
  "refresh": "1m",
  "schemaVersion": 39,
  "tags": [
    "github",
    "commit-status"
  ],
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "",
  "title": "Commit status",
  "uid": "commit-status",
  "version": 1,
  "weekStart": ""
}

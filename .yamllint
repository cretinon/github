---
# Shared YAML style with the rest of the fleet. `ansible-lint` reads it through its
# `yaml` rule, so the five settings it requires are set exactly as it asks for them.
extends: default

# the baseline SkillSpector generates starts its sequence at column 0 and is rewritten
# that way on every run: the gate lints the YAML we write, not the file a tool owns
ignore: |
  .skillspector-baseline.yaml

rules:
  # the git URL of the scanner and an unpacked tool spec are one long token: a width
  # wide enough for them keeps the file readable instead of breaking a URL in two
  line-length:
    max: 300
    allow-non-breakable-words: true
    allow-non-breakable-inline-mappings: true
  # a play and a task list start with their first key
  document-start: disable
  document-end: disable
  # required by ansible-lint
  comments:
    min-spaces-from-content: 1
  comments-indentation: false
  braces:
    max-spaces-inside: 1
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
  truthy:
    check-keys: false
